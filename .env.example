# Neon Postgres connection string (required for app data)
# Dashboard → your project → Connection string → URI (use pooled if offered)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Session signing secret — change in production
SESSION_SECRET=replace-with-a-long-random-string

# Optional admin bootstrap credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# Optional: enable real model calls in exercises/chat
# OPENAI_API_KEY=
